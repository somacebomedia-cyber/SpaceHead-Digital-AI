{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Showcase portfolio project details",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 100 },
        "tags": { "type": "array" },
        "demoUrl": { "type": "string", "maxLength": 500 },
        "githubUrl": { "type": "string", "maxLength": 500 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "number" },
        "userId": { "type": "string", "maxLength": 100 },
        "isPublic": { "type": "boolean" }
      },
      "required": ["title", "description", "category", "tags", "createdAt", "userId", "isPublic"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Showcase blog post details",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "maxLength": 10000 },
        "category": { "type": "string", "maxLength": 100 },
        "tags": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "userId": { "type": "string", "maxLength": 100 },
        "authorName": { "type": "string", "maxLength": 100 },
        "isPublished": { "type": "boolean" }
      },
      "required": ["title", "slug", "summary", "content", "category", "tags", "createdAt", "updatedAt", "userId", "authorName", "isPublished"]
    },
    "Settings": {
      "title": "Settings",
      "description": "App settings for Google Drive Sync",
      "type": "object",
      "properties": {
        "driveApiKey": { "type": "string", "maxLength": 200 },
        "videosFolderUrl": { "type": "string", "maxLength": 500 },
        "graphicsFolderUrl": { "type": "string", "maxLength": 500 }
      }
    },
    "ProjectBrief": {
      "title": "ProjectBrief",
      "description": "Customer project brief submitted from checkout modal",
      "type": "object",
      "properties": {
        "serviceId": { "type": "string", "maxLength": 100 },
        "serviceTitle": { "type": "string", "maxLength": 200 },
        "name": { "type": "string", "maxLength": 100 },
        "businessName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "brief": { "type": "string", "maxLength": 5000 },
        "referenceCode": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["serviceId", "serviceTitle", "name", "email", "phone", "brief", "referenceCode", "createdAt", "status"]
    },
    "WorkspaceLead": {
      "title": "WorkspaceLead",
      "description": "Customer lead inquiry submitted from contact page",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "businessName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "service": { "type": "string", "maxLength": 150 },
        "brief": { "type": "string", "maxLength": 5000 },
        "quoteCode": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "email", "phone", "service", "quoteCode", "createdAt", "status"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Portfolio Projects"
    },
    "/blogs/{blogId}": {
      "schema": "BlogPost",
      "description": "Portfolio Blog Posts"
    },
    "/settings/{settingsId}": {
      "schema": "Settings",
      "description": "App settings for Google Drive Sync"
    },
    "/project_briefs/{briefId}": {
      "schema": "ProjectBrief",
      "description": "Client Project Briefs"
    },
    "/workspace_leads/{leadId}": {
      "schema": "WorkspaceLead",
      "description": "Client Inbound Leads"
    }
  }
}
