# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_PAT: Optional Personal Access Token used to sync code to your repository from mobile.
GITHUB_PAT=""

# PAYFAST_MERCHANT_ID: Payfast Merchant ID (Default sandbox: 10000100)
PAYFAST_MERCHANT_ID="10000100"

# PAYFAST_MERCHANT_KEY: Payfast Merchant Key (Default sandbox: 46f0cd694581a)
PAYFAST_MERCHANT_KEY="46f0cd694581a"

# PAYFAST_PASSPHRASE: Payfast security passphrase (set in Payfast Merchant Console)
PAYFAST_PASSPHRASE=""

# PAYFAST_ENV: "sandbox" or "live"
PAYFAST_ENV="sandbox"

# FIREBASE_SERVICE_ACCOUNT_KEY: Optional JSON string of service account key for server-side Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_KEY=""

