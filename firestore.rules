rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidProject(data) {
      return data.title is string && data.title.size() <= 200
          && data.description is string && data.description.size() <= 1000
          && data.category is string && data.category.size() <= 100
          && data.tags is list && data.tags.size() <= 20
          && data.createdAt is number
          && data.userId is string && data.userId.size() <= 100
          && data.isPublic is bool;
    }

    function isValidBlogPost(data) {
      return data.title is string && data.title.size() <= 200
          && data.slug is string && data.slug.size() <= 200
          && data.summary is string && data.summary.size() <= 1000
          && data.content is string && data.content.size() <= 10000
          && data.category is string && data.category.size() <= 100
          && data.tags is list && data.tags.size() <= 20
          && data.createdAt is number
          && data.updatedAt is number
          && data.userId is string && data.userId.size() <= 100
          && data.authorName is string && data.authorName.size() <= 100
          && data.isPublished is bool;
    }

    function isValidBrief(data) {
      return data.name is string && data.name.size() <= 100
          && data.email is string && data.email.size() <= 200
          && data.phone is string && data.phone.size() <= 50
          && data.brief is string && data.brief.size() <= 5000;
    }

    function isValidLead(data) {
      return data.name is string && data.name.size() <= 100
          && data.email is string && data.email.size() <= 200
          && data.phone is string && data.phone.size() <= 50
          && data.brief is string && data.brief.size() <= 5000;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidProject(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidProject(incoming()) && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidBlogPost(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidBlogPost(incoming()) && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /settings/{userId} {
      allow get, write: if isValidId(userId) && isSignedIn() && request.auth.uid == userId;
    }

    match /project_briefs/{briefId} {
      allow create: if isValidBrief(incoming());
      allow read: if isSignedIn();
      allow update: if isSignedIn() && isValidBrief(incoming());
      allow delete: if isSignedIn();
    }

    match /workspace_leads/{leadId} {
      allow create: if isValidLead(incoming());
      allow read: if isSignedIn();
      allow update: if isSignedIn() && isValidLead(incoming());
      allow delete: if isSignedIn();
    }
  }
}



